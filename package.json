{
  "name": "moa-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "npm run build-only && wrangler dev",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "build-only:stg": "vite build --mode staging",
    "build-only:prod": "vite build --mode production",
    "build:stg": "run-p type-check \"build-only:stg {@}\" --",
    "build:prod": "run-p type-check \"build-only:prod {@}\" --",
    "deploy": "npm run build-only && wrangler deploy"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "pinia": "^3.0.4",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.32",
    "vue-i18n": "^11.0.0",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "@tailwindcss/vite": "^4.2.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.100.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "vite-plugin-inspect": {
      "vite": "$vite"
    },
    "vite-dev-rpc": {
      "vite": "$vite"
    },
    "vite-hot-client": {
      "vite": "$vite"
    }
  }
}
